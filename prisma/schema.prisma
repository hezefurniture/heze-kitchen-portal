datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  ADMIN
  USER
}

enum OrderStatus {
  PENDING
  IN_STOCK
  DESPATCHING
  DESPATCHED
}

enum ScanType {
  DELIVERY
  DESPATCH
}

model User {
  id         String   @id @default(cuid())
  username   String   @unique
  password   String
  name       String
  role       Role     @default(USER)
  createdAt  DateTime @default(now())
  loginToken String?  @unique

  deliveries Delivery[]
  scanLogs   ScanLog[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  orders         Order[]
  deliveries     Delivery[]
  columnMappings ColumnMapping[]
}

model Delivery {
  id           String   @id @default(cuid())
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  supplierId   String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  uploadedAt   DateTime @default(now())

  items OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  supplier        Supplier    @relation(fields: [supplierId], references: [id])
  supplierId      String
  orderNumber     String
  status          OrderStatus @default(PENDING)
  isAddition      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  movedToStockAt  DateTime?
  movedToStockBy  String?
  despatchedAt    DateTime?
  despatchedBy    String?

  items OrderItem[]

  @@unique([supplierId, orderNumber])
}

model OrderItem {
  id            String   @id @default(cuid())
  order         Order    @relation(fields: [orderId], references: [id])
  orderId       String
  delivery      Delivery @relation(fields: [deliveryId], references: [id])
  deliveryId    String
  itemName      String
  barcode       String
  quantity      Int
  scannedQty    Int      @default(0)
  despatchedQty Int      @default(0)
  parentBarcode String?
  parentName    String?

  scanLogs ScanLog[]

  @@index([barcode, orderId])
}

model AppSettings {
  id         String  @id @default("singleton")
  navLogo    String? // base64 encoded image for header navigation
  mainLogo   String? // base64 encoded image for login/dashboard pages
  appIcon192 String? // base64 encoded 192x192 PWA icon
  appIcon512 String? // base64 encoded 512x512 PWA icon
  extomAmbiguousBarcodes String? // JSON array of barcode strings for Extom disambiguation
  updatedAt  DateTime @default(now()) @updatedAt
}

// Column mapping configuration per supplier for file imports
// targetField: "orderNumber" | "itemName" | "barcode" | "quantity"
// sourceColumns: JSON array of source column names e.g. ["Col A", "Col B"]
// mergeStrategy: "first" (use first non-empty) | "concat" (join with separator) | "template" (use template string)
// separator: string used to join columns when strategy is "concat" (default: " ")
// template: template string like "{Col A} - {Col B}" when strategy is "template"
// prefix: static text prepended to result
// suffix: static text appended to result
model ColumnMapping {
  id             String   @id @default(cuid())
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  supplierId     String
  targetField    String   // orderNumber, itemName, barcode, quantity
  sourceColumns  String   // JSON array: ["Column A", "Column B"]
  mergeStrategy  String   @default("first") // first, concat, template
  separator      String   @default(" ")
  template       String   @default("")
  prefix         String   @default("")
  suffix         String   @default("")

  @@unique([supplierId, targetField])
}

model ScanLog {
  id          String   @id @default(cuid())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId String
  scannedBy   User     @relation(fields: [scannedById], references: [id])
  scannedById String
  scanType    ScanType
  barcode     String
  scannedAt   DateTime @default(now())
}
